# Скопируйте в .env. В проде задаются в настройках Vercel-проекта.

# Подключение к базе (SQLite через Turso).
# Поддерживаемые форматы URL:
#   libsql://<db>-<org>.turso.io   — облачная база Turso
#   https://…                      — совместимый HTTPS-эндпоинт
#   http://127.0.0.1:8080          — локальный turso dev
# В интеграции Turso переменные называются TURSO_DATABASE_URL / TURSO_AUTH_TOKEN.
# Проекту нужны имена ниже: Vercel → Settings → Environment Variables
# (локально: vercel env pull).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Разрешённые источники для POST /api/lead — через запятую.
# Проверяются заголовки Origin/Referer. Пусто = все запросы отклоняются (503).
# Пример: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# Публичный URL сайта — для metadataBase (абсолютные ссылки og:image
# в превью мессенджеров). Обязателен: без него сборка падает с "Invalid URL".
# Пример: https://kvarta.by
NEXT_PUBLIC_SITE_URL=

# Telegram-бот: дублирует каждую новую заявку в чат/канал менеджера.
# Обе переменные обязательны — сборка падает без них.
#
# 1. Создайте бота у @BotFather → получите токен (TELEGRAM_BOT_TOKEN).
# 2. Куда слать заявки (любой вариант, chat_id узнаете скриптом):
#      - приватный канал: создайте канал, добавьте бота админом, напишите пост;
#      - приватная группа: создайте группу, добавьте бота, напишите в ней;
#      - личный чат: напишите боту /start.
# 3. Узнайте chat_id: npm run telegram:setup (выводит все чаты бота).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
